# OpenRouter API Key (required for AI parsing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model (optional, default: google/gemini-3-flash-preview)
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# Database — REQUIRED: change POSTGRES_PASSWORD before any non-local deployment
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=postgres
# POSTGRES_DB=home_finance
# DATABASE_URL=postgresql://postgres:change-me@db:5432/home_finance

# JWT Secret Key (REQUIRED in production — use a random string of 32+ characters)
SECRET_KEY=your-secret-key-here

# JWT token lifetime in minutes (default: 60). Tokens are not server-side revocable;
# shorter values reduce exposure window if a token is stolen.
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Debug mode (set to false in production)
DEBUG=false

# Seed admin password (REQUIRED for initial migration)
SEED_ADMIN_PASSWORD=your-secure-password-here

# CORS allowed origins — REQUIRED for any deployment where frontend and backend
# are on different origins (separate domains, subdomains, or ports).
# Comma-separated list, e.g.: https://app.example.com,https://www.example.com
# CORS_ORIGINS=http://localhost:3000

# Rate limiting for auth endpoints (optional)
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX_REQUESTS=100

# Email / SMTP (optional — leave SMTP_HOST empty to disable email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your@gmail.com
# SMTP_TLS=true
# FRONTEND_URL=http://localhost:3000
